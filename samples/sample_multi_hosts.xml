<?xml version="1.0" encoding="UTF-8"?>
<nmaprun scanner="nmap" args="nmap -sV -oX sample_multi_host.xml">

    <!-- Host 1: Telnet - Expected HIGH finding -->
    <host>
        <status state="up" reason="syn-ack"/>
        <address addr="192.168.1.10" addrtype="ipv4"/>
        <hostnames>
            <hostname name="telnet-server" type="PTR"/>
        </hostnames>
        <ports>
            <port protocol="tcp" portid="23">
                <state state="open" reason="syn-ack"/>
                <service name="telnet"/>
            </port>
        </ports>
    </host>

    <!-- Host 2: MySQL - Expected MEDIUM finding -->
    <host>
        <status state="up" reason="syn-ack"/>
        <address addr="192.168.1.20" addrtype="ipv4"/>
        <hostnames>
            <hostname name="database-server" type="PTR"/>
        </hostnames>
        <ports>
            <port protocol="tcp" portid="3306">
                <state state="open" reason="syn-ack"/>
                <service name="mysql"
                         product="MySQL"
                         version="8.0.35"/>
            </port>
        </ports>
    </host>

    <!-- Host 3: SMTP - Expected LOW finding -->
    <host>
        <status state="up" reason="syn-ack"/>
        <address addr="192.168.1.30" addrtype="ipv4"/>
        <hostnames>
            <hostname name="mail-server" type="PTR"/>
        </hostnames>
        <ports>
            <port protocol="tcp" portid="25">
                <state state="open" reason="syn-ack"/>
                <service name="smtp"/>
            </port>
        </ports>
    </host>

    <!-- Host 4: SSH - No configured finding expected -->
    <host>
        <status state="up" reason="syn-ack"/>
        <address addr="192.168.1.40" addrtype="ipv4"/>
        <hostnames>
            <hostname name="ssh-server" type="PTR"/>
        </hostnames>
        <ports>
            <port protocol="tcp" portid="22">
                <state state="open" reason="syn-ack"/>
                <service name="ssh"
                         product="OpenSSH"
                         version="9.2"/>
            </port>
        </ports>
    </host>

    <runstats>
        <finished exit="success" summary="Synthetic multi-host test scan"/>
        <hosts up="4" down="0" total="4"/>
    </runstats>

</nmaprun>
